# Privileged deployment assets are source-distribution inputs, never wheel
# data selected by a directory wildcard.  The two shared Python library sources
# remain ordinary TermDeck modules and are also explicit private-package inputs.
include deploy/preparer-install-manifest.json
include deploy/termdeck-preparer-install-plan.md
include deploy/termdeck-preparer-broker
include deploy/termdeck-preparer-publication
include deploy/systemd/termdeck-runtime-attestd.service
include deploy/systemd/termdeck-preparer-broker.socket
include deploy/systemd/termdeck-preparer-broker.service
include deploy/systemd/termdeck-preparer.sysusers.conf
include deploy/systemd/termdeck-preparer.tmpfiles.conf
include scripts/deploy/install-preparer-assets.py
include scripts/deploy/build-preparer-arch-package.py
include scripts/deploy/termdeck-runtime-attestd
include scripts/termdeck-preparer-state.py
include scripts/termdeck-web-prepare-runtime.sh
include termdeck/__init__.py
include termdeck/runtime_attestation.py
