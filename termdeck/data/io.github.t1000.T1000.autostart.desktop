[Desktop Entry]
Type=Application
Version=1.0
Name=T1000
Comment=Restore managed terminal sessions at graphical-session start
Exec=@T1000_EXEC@
TryExec=@T1000_TRYEXEC@
Icon=t1000
Terminal=false
StartupNotify=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Notify=true
X-KDE-autostart-after=panel
X-T1000-Managed-Launcher=@T1000_MANAGED_LAUNCHER@
X-T1000-Storage-Policy=direct-root
X-T1000-Fail-Closed=true
