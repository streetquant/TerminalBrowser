#!/usr/bin/python3 -I
"""Root-only producer-to-consumer publication for the TermDeck LAN runtime.

The preparer owns a private runtime below ``/var/lib``.  User services consume
only the max-owned canonical runtime.  This helper is the fixed, packaged root
boundary between those trees: it seeds two approved build inputs, verifies the
producer's signed-receipt-bound postimages, and publishes a bounded consumer
snapshot with rollback to exact prior inodes on failure.

No path is accepted on the max-facing broker protocol.  The broker supplies
these fixed installation paths and numeric principals when invoking this
root-owned image.  The helper never signs a receipt and never exposes the
attestation key or socket to the consumer principal.
"""

from __future__ import annotations

import argparse
from contextlib import ExitStack
import ctypes
from dataclasses import dataclass, replace
import errno
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import stat
import sys
from typing import Final, Mapping, Sequence


SCHEMA: Final = "termdeck.preparer-publication.v1"
PRODUCER_ROOT: Final = Path("/var/lib/termdeck-preparer/runtime")
CONSUMER_ROOT: Final = Path("/warp/projects/softwares/termdeck/.termdeck")
MAX_BYTES: Final = 16 * 1024 * 1024
RECEIPT_MAX_BYTES: Final = 128 * 1024
LOWER_HEX = re.compile(r"[0-9a-f]{64}\Z")
GENERATION = re.compile(r"[0-9a-f]{32}\Z")
DIRECTORY_FLAGS = (
    os.O_RDONLY
    | getattr(os, "O_DIRECTORY", 0)
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_CLOEXEC", 0)
)
READ_FLAGS = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
WRITE_FLAGS = (
    os.O_WRONLY
    | os.O_CREAT
    | os.O_EXCL
    | getattr(os, "O_NOFOLLOW", 0)
    | getattr(os, "O_CLOEXEC", 0)
)
SOURCE_MODES: Final = {
    "bin/termdeck-web-server": 0o755,
    "nginx/nginx.conf": 0o600,
}
OUTPUT_MODES: Final = {
    "current-lan-ip": 0o600,
    "nginx/allowed-hosts.map": 0o600,
}
TLS_REQUIRED_MODES: Final = {
    "ca.crt": 0o644,
    "ca.key": 0o600,
    "server.key": 0o600,
    "server.crt": 0o644,
    "server-chain.crt": 0o644,
    "server.ext": 0o600,
}
TLS_OPTIONAL_MODES: Final = {"ca.srl": 0o644}
TLS_REQUIRED: Final = frozenset(TLS_REQUIRED_MODES)
TLS_OPTIONAL: Final = frozenset(TLS_OPTIONAL_MODES)
CONTROL_KEY = ".termdeck-tls-recovery-key"
RENAME_NOREPLACE: Final = 1
RENAME_EXCHANGE: Final = 2


class PublicationError(RuntimeError):
    """A producer, consumer, receipt, or transaction invariant was unsafe."""


@dataclass(frozen=True)
class Config:
    producer_root: Path
    consumer_root: Path
    preparer_uid: int
    preparer_gid: int
    consumer_uid: int
    consumer_gid: int
    enforce_principal_separation: bool = True

    def __post_init__(self) -> None:
        for path, label in (
            (self.producer_root, "producer root"),
            (self.consumer_root, "consumer root"),
        ):
            value = os.fspath(path)
            if not value or not os.path.isabs(value) or os.path.normpath(value) != value or "//" in value:
                raise PublicationError(f"{label} must be an absolute canonical path")
        if (
            self.producer_root == self.consumer_root
            or self.producer_root in self.consumer_root.parents
            or self.consumer_root in self.producer_root.parents
        ):
            raise PublicationError("producer and consumer roots must be disjoint")
        if min(self.preparer_uid, self.preparer_gid, self.consumer_uid, self.consumer_gid) < 0:
            raise PublicationError("publication principals are invalid")
        if self.enforce_principal_separation and (
            self.preparer_uid == self.consumer_uid or self.preparer_gid == self.consumer_gid
        ):
            raise PublicationError("producer and consumer principals must be separated")


@dataclass(frozen=True)
class Identity:
    device: int
    inode: int
    mode: int
    links: int
    size: int
    mtime_ns: int
    ctime_ns: int
    uid: int
    gid: int

    def payload(self) -> list[int]:
        return [
            self.device,
            self.inode,
            self.mode,
            self.links,
            self.size,
            self.mtime_ns,
            self.ctime_ns,
        ]


@dataclass(frozen=True)
class Leaf:
    content: bytes
    identity: Identity
    sha256: str


@dataclass(frozen=True)
class RootLease:
    path: Path
    descriptor: int
    identity: tuple[int, int, int, int, int]
    uid: int
    gid: int
    mode: int

    def revalidate(self) -> None:
        try:
            descriptor_info = os.fstat(self.descriptor)
            named_info = os.stat(self.path, follow_symlinks=False)
        except OSError as exc:
            raise PublicationError(f"runtime root changed: {self.path}") from exc
        if _directory_identity(descriptor_info, label=str(self.path)) != self.identity:
            raise PublicationError(f"runtime root descriptor changed: {self.path}")
        if _directory_identity(named_info, label=str(self.path)) != self.identity:
            raise PublicationError(f"runtime root path changed: {self.path}")
        if (
            int(descriptor_info.st_uid) != self.uid
            or int(descriptor_info.st_gid) != self.gid
            or stat.S_IMODE(descriptor_info.st_mode) != self.mode
        ):
            raise PublicationError(f"runtime root ownership or mode changed: {self.path}")

    def close(self) -> None:
        os.close(self.descriptor)


@dataclass
class _Operation:
    kind: str
    parent: int
    name: str
    backup: str | None = None
    published: bool = False


class Transaction:
    """Same-directory rename transaction retaining exact prior inodes."""

    def __init__(self) -> None:
        self._operations: list[_Operation] = []
        self._finished = False

    @staticmethod
    def _temporary(prefix: str) -> str:
        return f".{prefix}-{secrets.token_hex(16)}"

    def _record_operation(self, kind: str, parent: int, name: str, *, label: str) -> _Operation:
        """Retain rollback resources before changing any public name."""

        if self._finished:
            raise PublicationError("publication transaction is already finished")
        retained_parent = -1
        try:
            retained_parent = os.dup(parent)
            os.set_inheritable(retained_parent, False)
        except OSError as exc:
            if retained_parent >= 0:
                os.close(retained_parent)
            raise PublicationError(f"could not retain transaction descriptor for {label}") from exc
        operation = _Operation(kind, retained_parent, name)
        self._operations.append(operation)
        return operation

    def detach_file(
        self,
        parent: int,
        name: str,
        *,
        owner_uid: int,
        owner_gid: int,
        allowed_modes: frozenset[int],
        label: str,
    ) -> _Operation:
        try:
            descriptor = os.open(name, READ_FLAGS, dir_fd=parent)
        except FileNotFoundError:
            descriptor = -1
        except OSError as exc:
            raise PublicationError(f"could not inspect prior {label}") from exc
        if descriptor >= 0:
            try:
                identity = _regular_identity(os.fstat(descriptor), label=label)
                named = _regular_identity(
                    os.stat(name, dir_fd=parent, follow_symlinks=False), label=label
                )
                if identity != named:
                    raise PublicationError(f"prior {label} changed while opening")
                if (
                    identity.uid != owner_uid
                    or identity.gid != owner_gid
                    or identity.mode not in allowed_modes
                ):
                    raise PublicationError(f"prior {label} ownership or mode is unsafe")
            finally:
                os.close(descriptor)
        operation = self._record_operation("file", parent, name, label=label)
        if descriptor >= 0:
            backup = self._temporary("termdeck-prior")
            try:
                os.rename(name, backup, src_dir_fd=parent, dst_dir_fd=parent)
                operation.backup = backup
                os.fsync(parent)
            except OSError as exc:
                raise PublicationError(f"could not retain prior {label}") from exc
        return operation

    def replace_file(
        self,
        parent: int,
        name: str,
        content: bytes,
        *,
        mode: int,
        owner_uid: int,
        owner_gid: int,
        label: str,
    ) -> None:
        operation = self.detach_file(
            parent,
            name,
            owner_uid=owner_uid,
            owner_gid=owner_gid,
            allowed_modes=frozenset({mode}),
            label=label,
        )
        temporary = self._temporary("termdeck-new")
        descriptor = -1
        try:
            descriptor = os.open(temporary, WRITE_FLAGS, mode, dir_fd=parent)
            os.fchmod(descriptor, mode)
            os.fchown(descriptor, owner_uid, owner_gid)
            _write_all(descriptor, content, label=label)
            os.fsync(descriptor)
            os.close(descriptor)
            descriptor = -1
            os.rename(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
            operation.published = True
            os.fsync(parent)
        except BaseException as exc:
            if descriptor >= 0:
                os.close(descriptor)
            try:
                os.unlink(temporary, dir_fd=parent)
            except OSError:
                pass
            if isinstance(exc, PublicationError):
                raise
            raise PublicationError(f"could not publish {label}") from exc

    def swap_directory(
        self,
        parent: int,
        name: str,
        staged: str,
        *,
        owner_uid: int,
        owner_gid: int,
        mode: int,
        label: str,
    ) -> None:
        _validate_named_directory(
            parent,
            staged,
            owner_uid=owner_uid,
            owner_gid=owner_gid,
            mode=mode,
            label=f"staged {label}",
        )
        backup: str | None = None
        try:
            _validate_named_directory(
                parent,
                name,
                owner_uid=owner_uid,
                owner_gid=owner_gid,
                mode=mode,
                label=f"prior {label}",
            )
        except FileNotFoundError:
            pass
        else:
            backup = self._temporary("termdeck-prior-dir")
        operation = self._record_operation("directory", parent, name, label=label)
        if backup is not None:
            try:
                os.rename(name, backup, src_dir_fd=parent, dst_dir_fd=parent)
                operation.backup = backup
            except OSError as exc:
                raise PublicationError(f"could not retain prior {label}") from exc
        try:
            os.rename(staged, name, src_dir_fd=parent, dst_dir_fd=parent)
            operation.published = True
            os.fsync(parent)
        except OSError as exc:
            raise PublicationError(f"could not publish {label}") from exc

    def rollback(self) -> None:
        if self._finished:
            return
        errors: list[str] = []
        for operation in reversed(self._operations):
            try:
                if operation.backup is None and not operation.published:
                    continue
                if operation.kind == "directory":
                    garbage = ""
                    if operation.published:
                        garbage = self._temporary("termdeck-rollback-dir")
                        try:
                            os.rename(
                                operation.name,
                                garbage,
                                src_dir_fd=operation.parent,
                                dst_dir_fd=operation.parent,
                            )
                        except FileNotFoundError:
                            garbage = ""
                    if operation.backup is not None:
                        os.rename(
                            operation.backup,
                            operation.name,
                            src_dir_fd=operation.parent,
                            dst_dir_fd=operation.parent,
                        )
                    if garbage:
                        _remove_flat_directory(operation.parent, garbage)
                else:
                    if operation.published:
                        try:
                            os.unlink(operation.name, dir_fd=operation.parent)
                        except FileNotFoundError:
                            pass
                    if operation.backup is not None:
                        os.rename(
                            operation.backup,
                            operation.name,
                            src_dir_fd=operation.parent,
                            dst_dir_fd=operation.parent,
                        )
                os.fsync(operation.parent)
            except (OSError, PublicationError) as exc:
                errors.append(f"{operation.name}: {exc}")
            finally:
                os.close(operation.parent)
        self._finished = True
        if errors:
            raise PublicationError("consumer rollback failed: " + "; ".join(errors))

    def commit(self) -> tuple[str, ...]:
        """Commit the accepted postimage and report backup-cleanup failures.

        Once the new consumer postimage has been observed successfully,
        deleting retained preimages is cleanup rather than part of the commit.
        Reporting a cleanup failure as a failed publication would be false: the
        postimage is already live and this transaction can no longer restore
        the old names.
        """

        if self._finished:
            raise PublicationError("publication transaction is already finished")
        errors: list[str] = []
        for operation in self._operations:
            try:
                if operation.backup is not None:
                    if operation.kind == "directory":
                        _remove_flat_directory(operation.parent, operation.backup)
                    else:
                        os.unlink(operation.backup, dir_fd=operation.parent)
                    os.fsync(operation.parent)
            except (OSError, PublicationError) as exc:
                errors.append(f"{operation.name}: {exc}")
            finally:
                os.close(operation.parent)
        self._finished = True
        return tuple(errors)


def _directory_identity(info: os.stat_result, *, label: str) -> tuple[int, int, int, int, int]:
    if not stat.S_ISDIR(info.st_mode) or info.st_ino <= 0 or info.st_nlink <= 0:
        raise PublicationError(f"{label} is not a real directory")
    return (
        int(info.st_dev),
        int(info.st_ino),
        stat.S_IMODE(info.st_mode),
        int(info.st_uid),
        int(info.st_gid),
    )


def _regular_identity(info: os.stat_result, *, label: str) -> Identity:
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_ino <= 0
        or info.st_nlink != 1
        or info.st_size < 0
        or info.st_size > MAX_BYTES
    ):
        raise PublicationError(f"{label} is not one bounded regular file")
    return Identity(
        int(info.st_dev),
        int(info.st_ino),
        stat.S_IMODE(info.st_mode),
        int(info.st_nlink),
        int(info.st_size),
        int(info.st_mtime_ns),
        int(info.st_ctime_ns),
        int(info.st_uid),
        int(info.st_gid),
    )


def _open_root(path: Path, *, uid: int, gid: int, mode: int, label: str) -> RootLease:
    try:
        descriptor = os.open(path, DIRECTORY_FLAGS)
        descriptor_info = os.fstat(descriptor)
        named_info = os.stat(path, follow_symlinks=False)
    except OSError as exc:
        raise PublicationError(f"could not open {label}") from exc
    try:
        identity = _directory_identity(descriptor_info, label=label)
        if _directory_identity(named_info, label=label) != identity:
            raise PublicationError(f"{label} changed while opening")
        if int(descriptor_info.st_uid) != uid or int(descriptor_info.st_gid) != gid or stat.S_IMODE(descriptor_info.st_mode) != mode:
            raise PublicationError(f"{label} ownership or mode is unsafe")
        return RootLease(path, descriptor, identity, uid, gid, mode)
    except BaseException:
        os.close(descriptor)
        raise


def _safe_component(name: str, *, label: str) -> str:
    if not name or name in {".", ".."} or "/" in name or "\\" in name or "\x00" in name:
        raise PublicationError(f"unsafe {label}")
    return name


def _ensure_directory(parent: int, name: str, *, uid: int, gid: int, mode: int, label: str) -> int:
    _safe_component(name, label=label)
    try:
        os.mkdir(name, mode, dir_fd=parent)
        os.chown(name, uid, gid, dir_fd=parent, follow_symlinks=False)
    except FileExistsError:
        pass
    except OSError as exc:
        raise PublicationError(f"could not create {label}") from exc
    return _open_named_directory(parent, name, uid=uid, gid=gid, mode=mode, label=label)


def _open_named_directory(parent: int, name: str, *, uid: int, gid: int, mode: int, label: str) -> int:
    _safe_component(name, label=label)
    try:
        descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent)
        descriptor_info = os.fstat(descriptor)
        named_info = os.stat(name, dir_fd=parent, follow_symlinks=False)
    except OSError as exc:
        raise PublicationError(f"could not open {label}") from exc
    try:
        identity = _directory_identity(descriptor_info, label=label)
        if _directory_identity(named_info, label=label) != identity:
            raise PublicationError(f"{label} changed while opening")
        if int(descriptor_info.st_uid) != uid or int(descriptor_info.st_gid) != gid or stat.S_IMODE(descriptor_info.st_mode) != mode:
            raise PublicationError(f"{label} ownership or mode is unsafe")
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _validate_named_directory(parent: int, name: str, *, owner_uid: int, owner_gid: int, mode: int, label: str) -> None:
    descriptor = _open_named_directory(parent, name, uid=owner_uid, gid=owner_gid, mode=mode, label=label)
    os.close(descriptor)


def _parent_and_name(root: int, relative: str, *, uid: int, gid: int, create: bool) -> tuple[int, str, bool]:
    path = PurePosixPath(relative)
    if path.is_absolute() or len(path.parts) not in {1, 2} or any(part in {"", ".", ".."} for part in path.parts):
        raise PublicationError(f"unsafe publication path: {relative}")
    if len(path.parts) == 1:
        return root, path.name, False
    opener = _ensure_directory if create else _open_named_directory
    descriptor = opener(root, path.parts[0], uid=uid, gid=gid, mode=0o700, label=f"runtime {path.parts[0]}")
    return descriptor, path.name, True


def _read_leaf(parent: int, name: str, *, uid: int, gid: int, mode: int, label: str, max_bytes: int = MAX_BYTES) -> Leaf:
    _safe_component(name, label=label)
    descriptor = -1
    try:
        descriptor = os.open(name, READ_FLAGS, dir_fd=parent)
        before = _regular_identity(os.fstat(descriptor), label=label)
        named_before = _regular_identity(os.stat(name, dir_fd=parent, follow_symlinks=False), label=label)
        if before != named_before or before.uid != uid or before.gid != gid or before.mode != mode or before.size > max_bytes:
            raise PublicationError(f"{label} ownership, mode, or identity is unsafe")
        content = bytearray()
        while len(content) < before.size:
            block = os.read(descriptor, min(1024 * 1024, before.size - len(content)))
            if not block:
                raise PublicationError(f"{label} ended early")
            content.extend(block)
        if os.read(descriptor, 1):
            raise PublicationError(f"{label} grew while reading")
        after = _regular_identity(os.fstat(descriptor), label=label)
        named_after = _regular_identity(os.stat(name, dir_fd=parent, follow_symlinks=False), label=label)
        if before != after or before != named_after:
            raise PublicationError(f"{label} changed while reading")
        raw = bytes(content)
        return Leaf(raw, before, hashlib.sha256(raw).hexdigest())
    except OSError as exc:
        raise PublicationError(f"could not read {label}") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _read_relative(root: int, relative: str, *, uid: int, gid: int, mode: int, label: str) -> Leaf:
    parent, name, close_parent = _parent_and_name(root, relative, uid=uid, gid=gid, create=False)
    try:
        return _read_leaf(parent, name, uid=uid, gid=gid, mode=mode, label=label)
    finally:
        if close_parent:
            os.close(parent)


def _write_all(descriptor: int, content: bytes, *, label: str) -> None:
    offset = 0
    while offset < len(content):
        try:
            written = os.write(descriptor, content[offset:])
        except OSError as exc:
            raise PublicationError(f"could not write {label}") from exc
        if written <= 0:
            raise PublicationError(f"could not write {label}")
        offset += written


def _canonical_json(value: object) -> bytes:
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("ascii")


def _strict_json(content: bytes, *, label: str) -> dict[str, object]:
    def pairs(values: list[tuple[str, object]]) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, value in values:
            if key in result:
                raise PublicationError(f"{label} contains duplicate fields")
            result[key] = value
        return result

    try:
        value = json.loads(content.decode("ascii"), object_pairs_hook=pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise PublicationError(f"{label} is not strict JSON") from exc
    if not isinstance(value, dict) or content not in {_canonical_json(value), _canonical_json(value) + b"\n"}:
        raise PublicationError(f"{label} is not canonical JSON")
    return value


def _identity_claim(value: object, *, mode: int, label: str) -> tuple[list[int], str]:
    if not isinstance(value, Mapping) or set(value) not in (
        {"identity", "mode", "path", "sha256"},
        {"identity", "mode", "sha256"},
    ):
        raise PublicationError(f"{label} claim is invalid")
    identity = value.get("identity")
    digest = value.get("sha256")
    if (
        not isinstance(identity, list)
        or len(identity) != 7
        or not all(isinstance(item, int) and item >= 0 for item in identity)
        or identity[2] != mode
        or identity[3] != 1
        or value.get("mode") != mode
        or not isinstance(digest, str)
        or LOWER_HEX.fullmatch(digest) is None
    ):
        raise PublicationError(f"{label} claim is invalid")
    return identity, digest


def _receipt(producer: RootLease, config: Config) -> tuple[dict[str, object], Leaf]:
    leaf = _read_leaf(
        producer.descriptor,
        "build-receipt.json",
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o644,
        label="producer build receipt",
        max_bytes=RECEIPT_MAX_BYTES,
    )
    receipt = _strict_json(leaf.content, label="producer build receipt")
    if receipt.get("schema") != "termdeck.lan-runtime-build.v2" or receipt.get("ok") is not True:
        raise PublicationError("producer build receipt schema is invalid")
    generation = receipt.get("runtime_publication", {}).get("generation") if isinstance(receipt.get("runtime_publication"), Mapping) else None
    if not isinstance(generation, str) or GENERATION.fullmatch(generation) is None:
        raise PublicationError("producer runtime generation is invalid")
    return receipt, leaf


def _manifest(receipt: Mapping[str, object]) -> dict[str, Mapping[str, object]]:
    publication = receipt.get("tls_publication")
    if not isinstance(publication, Mapping):
        raise PublicationError("producer receipt lacks TLS publication")
    current = publication.get("current")
    if not isinstance(current, Mapping) or current.get("path") != "tls":
        raise PublicationError("producer receipt current TLS publication is invalid")
    manifest = current.get("manifest")
    if not isinstance(manifest, Mapping):
        raise PublicationError("producer TLS manifest is invalid")
    names = set(manifest)
    if not TLS_REQUIRED.issubset(names) or not names.issubset(TLS_REQUIRED | TLS_OPTIONAL):
        raise PublicationError("producer TLS manifest has an unsafe leaf set")
    parsed: dict[str, Mapping[str, object]] = {}
    for name, claim in manifest.items():
        if not isinstance(name, str) or not isinstance(claim, Mapping):
            raise PublicationError("producer TLS manifest is invalid")
        mode = claim.get("mode")
        expected_mode = TLS_REQUIRED_MODES.get(name, TLS_OPTIONAL_MODES.get(name))
        if not isinstance(mode, int) or expected_mode is None or mode != expected_mode:
            raise PublicationError(f"producer TLS mode is unsafe: {name}")
        _identity_claim(claim, mode=mode, label=f"producer TLS {name}")
        parsed[name] = claim
    return parsed


def _runtime_outputs(receipt: Mapping[str, object]) -> dict[str, Mapping[str, object]]:
    publication = receipt.get("runtime_publication")
    outputs = publication.get("outputs") if isinstance(publication, Mapping) else None
    if not isinstance(outputs, Mapping) or set(outputs) != set(OUTPUT_MODES):
        raise PublicationError("producer runtime outputs are invalid")
    parsed: dict[str, Mapping[str, object]] = {}
    for relative, mode in OUTPUT_MODES.items():
        claim = outputs.get(relative)
        if not isinstance(claim, Mapping) or claim.get("path") != relative:
            raise PublicationError(f"producer runtime output is invalid: {relative}")
        _identity_claim(claim, mode=mode, label=f"producer runtime {relative}")
        parsed[relative] = claim
    return parsed


def _file_digests(receipt: Mapping[str, object]) -> Mapping[str, object]:
    files = receipt.get("files")
    required = set(SOURCE_MODES) | {"tls/ca.crt", "tls/server.crt", "tls/server-chain.crt"}
    if not isinstance(files, Mapping) or set(files) != required:
        raise PublicationError("producer source digest set is invalid")
    if any(not isinstance(files[name], str) or LOWER_HEX.fullmatch(files[name]) is None for name in required):
        raise PublicationError("producer source digest is invalid")
    return files


def _claim(leaf: Leaf, *, path: str, mode: int) -> dict[str, object]:
    if leaf.identity.mode != mode or leaf.identity.links != 1:
        raise PublicationError(f"published leaf mode is invalid: {path}")
    return {
        "path": path,
        "identity": leaf.identity.payload(),
        "mode": mode,
        "sha256": leaf.sha256,
    }


def _copy_into(parent: int, name: str, leaf: Leaf, *, uid: int, gid: int, mode: int, label: str) -> None:
    temporary = f".termdeck-seed-{secrets.token_hex(16)}"
    descriptor = -1
    try:
        descriptor = os.open(temporary, WRITE_FLAGS, mode, dir_fd=parent)
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, uid, gid)
        _write_all(descriptor, leaf.content, label=label)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.rename(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    except BaseException as exc:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=parent)
        except OSError:
            pass
        if isinstance(exc, PublicationError):
            raise
        raise PublicationError(f"could not seed {label}") from exc


def _rename_noreplace(
    source_parent: int,
    source: str,
    destination_parent: int,
    destination: str,
    *,
    label: str,
) -> None:
    """Use Linux renameat2 so a concurrent destination is never overwritten."""

    _rename_with_flags(
        source_parent, source, destination_parent, destination,
        flags=RENAME_NOREPLACE, label=label,
    )


def _rename_with_flags(
    source_parent: int,
    source: str,
    destination_parent: int,
    destination: str,
    *,
    flags: int,
    label: str,
) -> None:

    try:
        rename = ctypes.CDLL(None, use_errno=True).renameat2
    except (AttributeError, OSError) as exc:
        raise PublicationError("secure publication requires renameat2") from exc
    rename.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    rename.restype = ctypes.c_int
    failure = 0
    for attempt in range(3):
        result = rename(
            source_parent,
            os.fsencode(source),
            destination_parent,
            os.fsencode(destination),
            flags,
        )
        if result == 0:
            return
        failure = ctypes.get_errno()
        if failure != errno.EINTR:
            break
        if attempt == 2:
            raise PublicationError(f"secure publication was interrupted: {label}")
    if failure == errno.EEXIST:
        raise FileExistsError(failure, os.strerror(failure), destination)
    if failure == errno.ENOENT:
        raise FileNotFoundError(failure, os.strerror(failure), source)
    if failure in {
        errno.ENOSYS,
        errno.EINVAL,
        errno.ENOTSUP,
        getattr(errno, "EOPNOTSUPP", errno.ENOTSUP),
    }:
        raise PublicationError("secure publication requires renameat2")
    raise PublicationError(
        f"secure no-replace publication failed for {label}: {os.strerror(failure)}"
    )


def _copy_into_noreplace(
    parent: int,
    name: str,
    leaf: Leaf,
    *,
    uid: int,
    gid: int,
    mode: int,
    label: str,
) -> None:
    """Publish one exact leaf without replacing a concurrent destination."""

    temporary = f".termdeck-migrate-{secrets.token_hex(16)}"
    descriptor = -1
    expected: Identity | None = None
    published_identity: Identity | None = None
    published = False
    try:
        descriptor = os.open(temporary, WRITE_FLAGS, mode, dir_fd=parent)
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, uid, gid)
        _write_all(descriptor, leaf.content, label=label)
        os.fsync(descriptor)
        expected = _regular_identity(os.fstat(descriptor), label=label)
        if (
            expected.uid != uid
            or expected.gid != gid
            or expected.mode != mode
            or expected.links != 1
            or expected.size != len(leaf.content)
        ):
            raise PublicationError(f"staged {label} ownership or mode is unsafe")
        _rename_noreplace(parent, temporary, parent, name, label=label)
        published = True
        published_identity = _regular_identity(os.fstat(descriptor), label=label)
        named = _regular_identity(
            os.stat(name, dir_fd=parent, follow_symlinks=False), label=label
        )
        if named != published_identity:
            raise PublicationError(f"published {label} path changed during no-replace migration")
        if (
            expected.device,
            expected.inode,
            expected.mode,
            expected.links,
            expected.size,
            expected.mtime_ns,
            expected.uid,
            expected.gid,
        ) != (
            published_identity.device,
            published_identity.inode,
            published_identity.mode,
            published_identity.links,
            published_identity.size,
            published_identity.mtime_ns,
            published_identity.uid,
            published_identity.gid,
        ):
            raise PublicationError(f"published {label} changed during no-replace migration")
        os.fsync(parent)
    except BaseException as exc:
        cleanup_errors: list[str] = []
        if published and published_identity is not None:
            try:
                current = _regular_identity(
                    os.stat(name, dir_fd=parent, follow_symlinks=False), label=label
                )
                if current == published_identity:
                    os.unlink(name, dir_fd=parent)
                    os.fsync(parent)
                else:
                    cleanup_errors.append("destination identity changed before rollback")
            except FileNotFoundError:
                pass
            except (OSError, PublicationError) as cleanup_exc:
                cleanup_errors.append(str(cleanup_exc))
        try:
            os.unlink(temporary, dir_fd=parent)
        except FileNotFoundError:
            pass
        except OSError as cleanup_exc:
            cleanup_errors.append(str(cleanup_exc))
        if cleanup_errors and hasattr(exc, "add_note"):
            exc.add_note("key-migration cleanup: " + "; ".join(cleanup_errors))
        if isinstance(exc, PublicationError):
            raise
        if isinstance(exc, FileExistsError):
            raise PublicationError(f"{label} appeared during no-replace migration") from exc
        raise PublicationError(f"could not migrate {label} without replacement") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _optional_leaf(
    parent: int,
    name: str,
    *,
    uid: int,
    gid: int,
    mode: int,
    label: str,
    max_bytes: int,
) -> Leaf | None:
    try:
        os.stat(name, dir_fd=parent, follow_symlinks=False)
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise PublicationError(f"could not inspect {label}") from exc
    return _read_leaf(
        parent,
        name,
        uid=uid,
        gid=gid,
        mode=mode,
        label=label,
        max_bytes=max_bytes,
    )


def _control_keys(
    config: Config,
    *,
    producer_parent: RootLease,
    consumer: RootLease,
) -> tuple[Leaf | None, Leaf | None]:

    legacy = _optional_leaf(
        consumer.descriptor,
        CONTROL_KEY,
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o600,
        label="legacy consumer TLS recovery key",
        max_bytes=64,
    )
    private = _optional_leaf(
        producer_parent.descriptor,
        CONTROL_KEY,
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o600,
        label="producer TLS recovery key",
        max_bytes=64,
    )
    if legacy is not None and len(legacy.content) != 32:
        raise PublicationError("legacy consumer TLS recovery key has an invalid size")
    if private is not None and len(private.content) != 32:
        raise PublicationError("producer TLS recovery key has an invalid size")
    if legacy is not None and private is not None and legacy.content != private.content:
        raise PublicationError("legacy and producer TLS recovery keys do not match")
    return legacy, private


def _migrate_control_key(
    config: Config,
    *,
    producer_parent: RootLease,
    consumer: RootLease,
    cleanup_warnings: list[str],
) -> str:
    """Move a legacy max-readable commitment key behind the preparer boundary."""

    legacy, private = _control_keys(
        config, producer_parent=producer_parent, consumer=consumer,
    )

    created_private = False
    removed_legacy = False
    stage = ""
    stage_fd = -1
    stage_identity = None

    def cleanup() -> None:
        if stage_identity is None:
            return
        if _directory_identity(
            os.stat(stage, dir_fd=consumer.descriptor, follow_symlinks=False),
            label="key migration staging path",
        ) != stage_identity:
            raise PublicationError("key migration staging changed; retained evidence")
        # rmdir refuses a nonempty directory; never discard a retained key.
        os.rmdir(stage, dir_fd=consumer.descriptor)
        os.fsync(consumer.descriptor)

    try:
        if private is None and legacy is not None:
            _copy_into_noreplace(
                producer_parent.descriptor,
                CONTROL_KEY,
                legacy,
                uid=config.preparer_uid,
                gid=config.preparer_gid,
                mode=0o600,
                label="producer TLS recovery key",
            )
            created_private = True
            private = _read_leaf(
                producer_parent.descriptor,
                CONTROL_KEY,
                uid=config.preparer_uid,
                gid=config.preparer_gid,
                mode=0o600,
                label="producer TLS recovery key",
                max_bytes=64,
            )
            if private.content != legacy.content:
                raise PublicationError("producer TLS recovery key migration changed the key")

        if legacy is None:
            return "private" if private is not None else "absent"

        producer_parent.revalidate()
        consumer.revalidate()
        rebound = _read_leaf(
            consumer.descriptor,
            CONTROL_KEY,
            uid=config.consumer_uid,
            gid=config.consumer_gid,
            mode=0o600,
            label="legacy consumer TLS recovery key",
            max_bytes=64,
        )
        if rebound.identity != legacy.identity or rebound.content != legacy.content:
            raise PublicationError("legacy consumer TLS recovery key changed before migration")
        stage = f".termdeck-key-migration-{secrets.token_hex(16)}"
        os.mkdir(stage, 0o700, dir_fd=consumer.descriptor)
        stage_identity = _directory_identity(
            os.stat(stage, dir_fd=consumer.descriptor, follow_symlinks=False),
            label="key migration stage",
        )
        stage_fd = _open_named_directory(
            consumer.descriptor, stage, uid=os.geteuid(), gid=os.getegid(),
            mode=0o700, label="root-private key migration stage",
        )
        stage_identity = _directory_identity(os.fstat(stage_fd), label="key migration stage")
        _rename_noreplace(
            consumer.descriptor, CONTROL_KEY, stage_fd, CONTROL_KEY,
            label="retained legacy recovery key",
        )
        removed_legacy = True
        retained = _read_leaf(
            stage_fd, CONTROL_KEY, uid=config.consumer_uid, gid=config.consumer_gid,
            mode=0o600, label="retained legacy recovery key", max_bytes=64,
        )
        if (
            retained.content != legacy.content
            or replace(retained.identity, ctime_ns=legacy.identity.ctime_ns) != legacy.identity
        ):
            raise PublicationError("legacy recovery key changed during migration")
        os.fsync(stage_fd)
        os.fsync(consumer.descriptor)
        producer_parent.revalidate()
        consumer.revalidate()
        if _read_leaf(
            producer_parent.descriptor, CONTROL_KEY, uid=config.preparer_uid,
            gid=config.preparer_gid, mode=0o600, label="producer TLS recovery key",
            max_bytes=64,
        ) != private:
            raise PublicationError("private recovery key changed during migration")
        # This unlink is the migration commit. Subsequent directory durability
        # or empty-stage cleanup failures cannot truthfully roll it back.
        os.unlink(CONTROL_KEY, dir_fd=stage_fd)
    except BaseException as exc:
        rollback_errors: list[str] = []
        if removed_legacy and legacy is not None:
            try:
                _rename_noreplace(
                    stage_fd, CONTROL_KEY, consumer.descriptor, CONTROL_KEY,
                    label="legacy recovery key rollback",
                )
                os.fsync(consumer.descriptor)
            except BaseException as rollback_exc:
                rollback_errors.append(f"legacy key restore: {rollback_exc}")
        if created_private:
            try:
                current = _read_leaf(
                    producer_parent.descriptor,
                    CONTROL_KEY,
                    uid=config.preparer_uid,
                    gid=config.preparer_gid,
                    mode=0o600,
                    label="producer TLS recovery key rollback",
                    max_bytes=64,
                )
                if private is None or current != private:
                    raise PublicationError("producer TLS recovery key changed during rollback")
                os.unlink(CONTROL_KEY, dir_fd=producer_parent.descriptor)
                os.fsync(producer_parent.descriptor)
            except BaseException as rollback_exc:
                rollback_errors.append(f"producer key rollback: {rollback_exc}")
        try:
            cleanup()
        except (OSError, PublicationError) as cleanup_exc:
            rollback_errors.append(f"key staging cleanup: {cleanup_exc}")
        if rollback_errors and hasattr(exc, "add_note"):
            exc.add_note("; ".join(rollback_errors))
        raise
    else:
        try:
            os.fsync(stage_fd)
            cleanup()
        except (OSError, PublicationError) as cleanup_exc:
            cleanup_warnings.append(f"committed recovery-key migration cleanup: {cleanup_exc}")
        return "migrated"
    finally:
        if stage_fd >= 0:
            os.close(stage_fd)


def _tls_leaves(config: Config, descriptor: int, *, consumer: bool) -> dict[str, Leaf]:
    names = set(os.listdir(descriptor))
    approved = TLS_REQUIRED | TLS_OPTIONAL
    if not consumer and not names.issubset(approved):
        raise PublicationError("producer TLS directory contains unexpected entries")
    return {
        name: _read_leaf(
            descriptor, name,
            uid=config.consumer_uid if consumer else config.preparer_uid,
            gid=config.consumer_gid if consumer else config.preparer_gid,
            mode=(TLS_REQUIRED_MODES | TLS_OPTIONAL_MODES)[name],
            label=f"{'consumer' if consumer else 'producer'} TLS {name}",
        )
        for name in sorted(names & approved)
    }


def _check_tls_snapshot(
    config: Config,
    parent: int,
    name: str,
    descriptor: int,
    identity: tuple[int, int, int, int, int],
    leaves: Mapping[str, Leaf],
    *,
    consumer: bool = False,
) -> None:
    if (
        _directory_identity(os.fstat(descriptor), label="seed TLS descriptor") != identity
        or _directory_identity(
            os.stat(name, dir_fd=parent, follow_symlinks=False), label="seed TLS path",
        ) != identity
        or _tls_leaves(config, descriptor, consumer=consumer) != leaves
    ):
        raise PublicationError("TLS seed directory or leaves changed")


def _initial_seed_inputs(
    config: Config,
    producer: RootLease,
    sources: Mapping[str, Leaf],
    *,
    partial: bool,
    staged: str = "",
) -> dict[str, Leaf]:
    """A legacy interrupted seed has no build output, receipt or journal."""

    root_names = set(os.listdir(producer.descriptor))
    if root_names - {"bin", "nginx", "tls", staged}:
        raise PublicationError("incomplete producer TLS has generation or unexpected state")
    retained: dict[str, Leaf] = {}
    for relative, mode in SOURCE_MODES.items():
        directory, name = relative.split("/")
        if directory not in root_names:
            if partial:
                raise PublicationError("partial TLS seed lacks its preceding source inputs")
            continue
        parent = _open_named_directory(
            producer.descriptor, directory, uid=config.preparer_uid,
            gid=config.preparer_gid, mode=0o700, label="initial producer source directory",
        )
        try:
            if set(os.listdir(parent)) - {name}:
                raise PublicationError("incomplete producer TLS has generation or unexpected state")
            leaf = _optional_leaf(
                parent, name, uid=config.preparer_uid, gid=config.preparer_gid,
                mode=mode, label=f"initial producer source {relative}", max_bytes=MAX_BYTES,
            )
            if partial and (leaf is None or leaf.content != sources[relative].content):
                raise PublicationError("partial TLS seed does not match its preceding source inputs")
            if leaf is not None:
                retained[relative] = leaf
        finally:
            os.close(parent)
    return retained


@dataclass
class _TLSSeed:
    config: Config
    producer: RootLease
    consumer: RootLease
    consumer_fd: int
    consumer_identity: tuple[int, int, int, int, int]
    source: dict[str, Leaf]
    producer_fd: int | None
    prior_identity: tuple[int, int, int, int, int] | None
    prior: dict[str, Leaf]
    inputs: Mapping[str, Leaf]
    prior_inputs: dict[str, Leaf]
    staged: str = ""
    staged_fd: int = -1
    staged_identity: tuple[int, int, int, int, int] | None = None
    staged_leaves: dict[str, Leaf] | None = None
    published: bool = False

    def revalidate(self) -> None:
        self.producer.revalidate()
        self.consumer.revalidate()
        for relative, expected in self.inputs.items():
            actual = _read_relative(
                self.consumer.descriptor, relative, uid=self.config.consumer_uid,
                gid=self.config.consumer_gid, mode=SOURCE_MODES[relative],
                label=f"consumer source {relative}",
            )
            if actual != expected:
                raise PublicationError("consumer seed input changed")
        _check_tls_snapshot(
            self.config, self.consumer.descriptor, "tls", self.consumer_fd,
            self.consumer_identity, self.source, consumer=True,
        )
        if _initial_seed_inputs(
            self.config, self.producer, self.inputs, partial=bool(self.prior),
            staged=self.staged,
        ) != self.prior_inputs:
            raise PublicationError("producer seed inputs changed")
        if self.producer_fd is not None:
            assert self.prior_identity is not None
            _check_tls_snapshot(
                self.config, self.producer.descriptor,
                self.staged if self.published else "tls", self.producer_fd,
                self.prior_identity, self.prior,
            )
        elif not self.published and "tls" in os.listdir(self.producer.descriptor):
            raise PublicationError("producer TLS appeared before initial seed")

    def publish(self) -> None:
        self.staged = f".termdeck-seed-tls-{secrets.token_hex(16)}"
        os.mkdir(self.staged, 0o700, dir_fd=self.producer.descriptor)
        self.staged_identity = _directory_identity(
            os.stat(self.staged, dir_fd=self.producer.descriptor, follow_symlinks=False),
            label="TLS seed stage",
        )
        self.staged_fd = os.open(self.staged, DIRECTORY_FLAGS, dir_fd=self.producer.descriptor)
        self.staged_leaves = {}
        # Keep construction root-private until all validated inputs are durable.
        os.fchmod(self.staged_fd, 0o700)
        self.staged_identity = _directory_identity(os.fstat(self.staged_fd), label="TLS seed stage")
        for name, leaf in self.source.items():
            _copy_into_noreplace(
                self.staged_fd, name, leaf, uid=self.config.preparer_uid,
                gid=self.config.preparer_gid, mode=leaf.identity.mode,
                label=f"staged producer TLS {name}",
            )
            self.staged_leaves[name] = _read_leaf(
                self.staged_fd, name, uid=self.config.preparer_uid,
                gid=self.config.preparer_gid, mode=leaf.identity.mode,
                label=f"staged producer TLS {name}",
            )
        os.fchown(self.staged_fd, self.config.preparer_uid, self.config.preparer_gid)
        self.staged_identity = _directory_identity(os.fstat(self.staged_fd), label="TLS seed stage")
        if _tls_leaves(self.config, self.staged_fd, consumer=False) != self.staged_leaves or {
            name: leaf.content for name, leaf in self.staged_leaves.items()
        } != {
            name: leaf.content for name, leaf in self.source.items()
        }:
            raise PublicationError("staged producer TLS differs from source")
        os.fsync(self.staged_fd)
        self.revalidate()
        _check_tls_snapshot(
            self.config, self.producer.descriptor, self.staged, self.staged_fd,
            self.staged_identity, self.staged_leaves,
        )
        if self.producer_fd is None:
            _rename_noreplace(
                self.producer.descriptor, self.staged, self.producer.descriptor, "tls",
                label="initial producer TLS",
            )
        else:
            _rename_with_flags(
                self.producer.descriptor, self.staged, self.producer.descriptor, "tls",
                flags=RENAME_EXCHANGE, label="initial producer TLS",
            )
        self.published = True
        os.fsync(self.producer.descriptor)
        self.revalidate()
        _check_tls_snapshot(
            self.config, self.producer.descriptor, "tls", self.staged_fd,
            self.staged_identity, self.staged_leaves,
        )

    def rollback(self) -> None:
        if self.published:
            assert self.staged_identity is not None and self.staged_leaves is not None
            _check_tls_snapshot(
                self.config, self.producer.descriptor, "tls", self.staged_fd,
                self.staged_identity, self.staged_leaves,
            )
            if self.producer_fd is None:
                _rename_noreplace(
                    self.producer.descriptor, "tls", self.producer.descriptor, self.staged,
                    label="initial TLS rollback",
                )
            else:
                # Exchange also restores a concurrent replacement displaced at the
                # atomic boundary. Never delete that retained conflicting tree.
                _rename_with_flags(
                    self.producer.descriptor, self.staged, self.producer.descriptor, "tls",
                    flags=RENAME_EXCHANGE, label="initial TLS rollback",
                )
            self.published = False
            os.fsync(self.producer.descriptor)
        self.cleanup()

    def cleanup(self) -> None:
        if not self.staged or self.staged_identity is None:
            return
        if self.staged_fd < 0:
            if _directory_identity(
                os.stat(self.staged, dir_fd=self.producer.descriptor, follow_symlinks=False),
                label="TLS seed cleanup path",
            ) != self.staged_identity:
                raise PublicationError("TLS seed cleanup path changed; retained evidence")
            os.rmdir(self.staged, dir_fd=self.producer.descriptor)
            self.staged = ""
            os.fsync(self.producer.descriptor)
            return
        if self.published:
            if self.producer_fd is None:
                return
            assert self.prior_identity is not None
            _check_tls_snapshot(
                self.config, self.producer.descriptor, self.staged, self.producer_fd,
                self.prior_identity, self.prior,
            )
            identity, leaves = self.prior_identity, self.prior
        else:
            # A staging failure may leave only part of the private candidate.
            identity = _directory_identity(os.fstat(self.staged_fd), label="TLS seed cleanup")
            if identity != self.staged_identity or _directory_identity(
                os.stat(self.staged, dir_fd=self.producer.descriptor, follow_symlinks=False),
                label="TLS seed cleanup path",
            ) != identity:
                raise PublicationError("TLS seed cleanup path changed; retained evidence")
            leaves = _tls_leaves(self.config, self.staged_fd, consumer=False)
            if leaves != self.staged_leaves:
                raise PublicationError("TLS seed cleanup content changed; retained evidence")
        _remove_flat_directory(
            self.producer.descriptor, self.staged,
            expected_identity=identity, expected_leaves=leaves,
        )
        self.staged = ""
        os.fsync(self.producer.descriptor)


def _plan_tls_seed(
    config: Config, producer: RootLease, consumer: RootLease,
    sources: Mapping[str, Leaf], stack: ExitStack,
) -> _TLSSeed | None:
    producer_fd = None
    prior_identity = None
    prior: dict[str, Leaf] = {}
    if "tls" in os.listdir(producer.descriptor):
        producer_fd = _open_named_directory(
            producer.descriptor, "tls", uid=config.preparer_uid, gid=config.preparer_gid,
            mode=0o700, label="producer TLS directory",
        )
        stack.callback(os.close, producer_fd)
        prior_identity = _directory_identity(os.fstat(producer_fd), label="producer TLS directory")
        prior = _tls_leaves(config, producer_fd, consumer=False)
        if TLS_REQUIRED.issubset(prior):
            return None  # An established complete set is never reseeded.
    consumer_fd = _open_named_directory(
        consumer.descriptor, "tls", uid=config.consumer_uid, gid=config.consumer_gid,
        mode=0o700, label="consumer TLS directory",
    )
    stack.callback(os.close, consumer_fd)
    consumer_identity = _directory_identity(os.fstat(consumer_fd), label="consumer TLS directory")
    source = _tls_leaves(config, consumer_fd, consumer=True)
    prior_inputs = _initial_seed_inputs(config, producer, sources, partial=bool(prior))
    if not source and not prior:
        return None  # The preparer may generate the first TLS set from scratch.
    if not TLS_REQUIRED.issubset(source):
        raise PublicationError("consumer TLS seed is incomplete")
    # native13 copied these names in sorted order. Only its exact retained
    # prefix, with all preceding source inputs intact, can be resumed.
    if list(prior) != list(source)[:len(prior)]:
        raise PublicationError("incomplete producer TLS is not an initial seed prefix")
    if any(leaf.content != source[name].content for name, leaf in prior.items()):
        raise PublicationError("partial producer TLS conflicts with consumer seed")
    return _TLSSeed(
        config, producer, consumer, consumer_fd, consumer_identity, source,
        producer_fd, prior_identity, prior, sources, prior_inputs,
    )


def seed(config: Config) -> dict[str, object]:
    with ExitStack() as stack:
        roots = []
        for path, uid, gid, label in (
            (config.producer_root, config.preparer_uid, config.preparer_gid, "private producer root"),
            (config.consumer_root, config.consumer_uid, config.consumer_gid, "user consumer root"),
            (config.producer_root.parent, config.preparer_uid, config.preparer_gid, "producer control parent"),
        ):
            root = _open_root(path, uid=uid, gid=gid, mode=0o700, label=label)
            stack.callback(root.close)
            roots.append(root)
        producer, consumer, producer_parent = roots
        # Validate every approved source and both recovery-key locations before
        # the first write. In particular server.ext must already be 0600.
        sources = {
            relative: _read_relative(
                consumer.descriptor, relative, uid=config.consumer_uid,
                gid=config.consumer_gid, mode=mode, label=f"consumer source {relative}",
            )
            for relative, mode in SOURCE_MODES.items()
        }
        _control_keys(config, producer_parent=producer_parent, consumer=consumer)
        tls_seed = _plan_tls_seed(config, producer, consumer, sources, stack)
        transaction = Transaction()
        copied: list[str] = []
        warnings: list[str] = []
        try:
            if tls_seed is not None:
                tls_seed.publish()
                copied.extend("tls/" + name for name in tls_seed.source)
            for relative, source in sources.items():
                parent, name, close_parent = _parent_and_name(
                    producer.descriptor, relative, uid=config.preparer_uid,
                    gid=config.preparer_gid, create=True,
                )
                try:
                    prior = _optional_leaf(
                        parent, name, uid=config.preparer_uid, gid=config.preparer_gid,
                        mode=SOURCE_MODES[relative], label=f"producer source {relative}",
                        max_bytes=MAX_BYTES,
                    )
                    if prior is None or prior.content != source.content:
                        transaction.replace_file(
                            parent, name, source.content, mode=SOURCE_MODES[relative],
                            owner_uid=config.preparer_uid, owner_gid=config.preparer_gid,
                            label=f"producer source {relative}",
                        )
                        copied.append(relative)
                finally:
                    if close_parent:
                        os.close(parent)
            producer.revalidate()
            consumer.revalidate()
            producer_parent.revalidate()
            control_key = _migrate_control_key(
                config, producer_parent=producer_parent, consumer=consumer,
                cleanup_warnings=warnings,
            )
        except BaseException as exc:
            for rollback in (transaction.rollback, tls_seed.rollback if tls_seed else lambda: None):
                try:
                    rollback()
                except BaseException as rollback_exc:
                    if hasattr(exc, "add_note"):
                        exc.add_note(f"seed rollback retained evidence: {rollback_exc}")
            if isinstance(exc, PublicationError):
                raise
            raise PublicationError("could not atomically seed producer inputs") from exc
        else:
            warnings.extend(transaction.commit())
            if tls_seed is not None:
                try:
                    tls_seed.cleanup()
                except (OSError, PublicationError) as cleanup_exc:
                    warnings.append(f"TLS seed retained preimage: {cleanup_exc}")
            if control_key == "migrated":
                copied.append(CONTROL_KEY)
            result: dict[str, object] = {
                "schema": SCHEMA, "operation": "seed", "copied": sorted(copied),
                "control_key": control_key, "ok": True,
            }
            if warnings:
                result["cleanup_warnings"] = warnings
            return result
        finally:
            if tls_seed is not None and tls_seed.staged_fd >= 0:
                os.close(tls_seed.staged_fd)


def _collect_producer(config: Config, producer: RootLease) -> tuple[dict[str, object], Leaf, dict[str, Leaf], dict[str, Leaf]]:
    receipt, receipt_leaf = _receipt(producer, config)
    files = _file_digests(receipt)
    outputs = _runtime_outputs(receipt)
    manifest = _manifest(receipt)
    output_leaves: dict[str, Leaf] = {}
    for relative, mode in OUTPUT_MODES.items():
        leaf = _read_relative(
            producer.descriptor,
            relative,
            uid=config.preparer_uid,
            gid=config.preparer_gid,
            mode=mode,
            label=f"producer output {relative}",
        )
        identity, digest = _identity_claim(outputs[relative], mode=mode, label=f"producer output {relative}")
        if leaf.identity.payload() != identity or leaf.sha256 != digest:
            raise PublicationError(f"producer output does not match receipt: {relative}")
        output_leaves[relative] = leaf
    tls_fd = _open_named_directory(
        producer.descriptor,
        "tls",
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o700,
        label="producer TLS directory",
    )
    tls_leaves: dict[str, Leaf] = {}
    try:
        if set(os.listdir(tls_fd)) & (TLS_REQUIRED | TLS_OPTIONAL) != set(manifest):
            raise PublicationError("producer TLS leaf set does not match receipt")
        for name, claim in manifest.items():
            mode = int(claim["mode"])
            leaf = _read_leaf(
                tls_fd,
                name,
                uid=config.preparer_uid,
                gid=config.preparer_gid,
                mode=mode,
                label=f"producer TLS {name}",
            )
            identity, digest = _identity_claim(claim, mode=mode, label=f"producer TLS {name}")
            if leaf.identity.payload() != identity or leaf.sha256 != digest:
                raise PublicationError(f"producer TLS does not match receipt: {name}")
            if "tls/" + name in files and leaf.sha256 != files["tls/" + name]:
                raise PublicationError(f"producer TLS source digest does not match receipt: {name}")
            tls_leaves[name] = leaf
    finally:
        os.close(tls_fd)
    return receipt, receipt_leaf, output_leaves, tls_leaves


def _verify_consumer_sources(config: Config, consumer: RootLease, receipt: Mapping[str, object]) -> None:
    files = _file_digests(receipt)
    for relative, mode in SOURCE_MODES.items():
        leaf = _read_relative(
            consumer.descriptor,
            relative,
            uid=config.consumer_uid,
            gid=config.consumer_gid,
            mode=mode,
            label=f"consumer source {relative}",
        )
        if leaf.sha256 != files[relative]:
            raise PublicationError(f"consumer source does not match producer receipt: {relative}")


def _stage_tls(config: Config, consumer: RootLease, tls_leaves: Mapping[str, Leaf]) -> str:
    name = f".termdeck-new-tls-{secrets.token_hex(16)}"
    try:
        os.mkdir(name, 0o700, dir_fd=consumer.descriptor)
        os.chown(name, config.consumer_uid, config.consumer_gid, dir_fd=consumer.descriptor, follow_symlinks=False)
    except OSError as exc:
        raise PublicationError("could not stage consumer TLS directory") from exc
    descriptor = _open_named_directory(
        consumer.descriptor,
        name,
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o700,
        label="staged consumer TLS directory",
    )
    try:
        for leaf_name, leaf in tls_leaves.items():
            _copy_into(
                descriptor,
                leaf_name,
                leaf,
                uid=config.consumer_uid,
                gid=config.consumer_gid,
                mode=leaf.identity.mode,
                label=f"consumer TLS {leaf_name}",
            )
    except BaseException:
        os.close(descriptor)
        _remove_flat_directory(consumer.descriptor, name)
        raise
    os.close(descriptor)
    return name


def _remove_flat_directory(
    parent: int, name: str, *,
    expected_identity: tuple[int, int, int, int, int] | None = None,
    expected_leaves: Mapping[str, Leaf] | None = None,
) -> None:
    descriptor = os.open(name, DIRECTORY_FLAGS, dir_fd=parent)
    try:
        identity = _directory_identity(os.fstat(descriptor), label="temporary publication directory")
        names = os.listdir(descriptor)
        if expected_identity is not None and identity != expected_identity:
            raise PublicationError("temporary publication directory changed; retained evidence")
        if expected_leaves is not None and set(names) != set(expected_leaves):
            raise PublicationError("temporary publication leaf set changed; retained evidence")
        for child in names:
            _safe_component(child, label="temporary publication child")
            info = os.stat(child, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                raise PublicationError("temporary publication directory contains an unsafe entry")
            if expected_leaves is not None and _regular_identity(info, label=child) != expected_leaves[child].identity:
                raise PublicationError("temporary publication leaf changed; retained evidence")
            os.unlink(child, dir_fd=descriptor)
        os.fsync(descriptor)
        if _directory_identity(
            os.stat(name, dir_fd=parent, follow_symlinks=False), label="temporary publication path",
        ) != identity:
            raise PublicationError("temporary publication path changed; retained evidence")
    finally:
        os.close(descriptor)
    os.rmdir(name, dir_fd=parent)


def _observe_consumer(
    config: Config,
    consumer: RootLease,
    receipt_leaf: Leaf,
    output_leaves: Mapping[str, Leaf],
    tls_leaves: Mapping[str, Leaf],
) -> dict[str, object]:
    observed_receipt = _read_leaf(
        consumer.descriptor,
        "build-receipt.json",
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o644,
        label="consumer build receipt",
        max_bytes=RECEIPT_MAX_BYTES,
    )
    if observed_receipt.content != receipt_leaf.content:
        raise PublicationError("consumer build receipt differs from producer receipt")
    outputs: dict[str, object] = {}
    for relative, mode in OUTPUT_MODES.items():
        observed = _read_relative(
            consumer.descriptor,
            relative,
            uid=config.consumer_uid,
            gid=config.consumer_gid,
            mode=mode,
            label=f"consumer output {relative}",
        )
        if observed.content != output_leaves[relative].content:
            raise PublicationError(f"consumer output differs from producer: {relative}")
        outputs[relative] = _claim(observed, path=relative, mode=mode)
    tls_fd = _open_named_directory(
        consumer.descriptor,
        "tls",
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o700,
        label="consumer TLS directory",
    )
    manifest: dict[str, object] = {}
    try:
        if set(os.listdir(tls_fd)) != set(tls_leaves):
            raise PublicationError("consumer TLS leaf set differs from producer")
        for name, expected in tls_leaves.items():
            observed = _read_leaf(
                tls_fd,
                name,
                uid=config.consumer_uid,
                gid=config.consumer_gid,
                mode=expected.identity.mode,
                label=f"consumer TLS {name}",
            )
            if observed.content != expected.content:
                raise PublicationError(f"consumer TLS differs from producer: {name}")
            manifest[name] = _claim(observed, path=name, mode=expected.identity.mode)
        directory = _directory_identity(os.fstat(tls_fd), label="consumer TLS directory")
    finally:
        os.close(tls_fd)
    return {
        "schema": SCHEMA,
        "receipt": _claim(observed_receipt, path="build-receipt.json", mode=0o644),
        "outputs": outputs,
        "tls": {
            "path": "tls",
            "identity": list(directory[:4]),
            "manifest": manifest,
        },
    }



def _consumer_tls_reuse(
    config: Config, consumer: RootLease, tls_leaves: Mapping[str, Leaf],
) -> tuple[int, tuple[int, int, int, int, int], dict[str, Leaf]] | None:
    """Retain an exact consumer copy instead of replacing its TLS inodes."""
    try:
        os.stat("tls", dir_fd=consumer.descriptor, follow_symlinks=False)
    except FileNotFoundError:
        return None
    descriptor = _open_named_directory(
        consumer.descriptor, "tls", uid=config.consumer_uid,
        gid=config.consumer_gid, mode=0o700, label="consumer TLS reuse",
    )
    keep = False
    try:
        names = set(os.listdir(descriptor))
        if not names.issubset(TLS_REQUIRED | TLS_OPTIONAL):
            raise PublicationError("consumer TLS reuse contains unexpected entries")
        identity = _directory_identity(os.fstat(descriptor), label="consumer TLS reuse")
        observed = _tls_leaves(config, descriptor, consumer=True)
        _check_tls_snapshot(
            config, consumer.descriptor, "tls", descriptor, identity, observed,
            consumer=True,
        )
        if names != set(tls_leaves) or any(
            observed[name].content != expected.content
            or observed[name].identity.mode != expected.identity.mode
            for name, expected in tls_leaves.items()
            if name in observed
        ):
            return None
        keep = True
        return descriptor, identity, observed
    finally:
        if not keep:
            os.close(descriptor)


def _assert_consumer_tls_reuse(
    config: Config, consumer: RootLease,
    reuse: tuple[int, tuple[int, int, int, int, int], dict[str, Leaf]],
) -> None:
    descriptor, identity, observed = reuse
    consumer.revalidate()
    if set(os.listdir(descriptor)) != set(observed):
        raise PublicationError("consumer TLS reuse leaf set changed")
    _check_tls_snapshot(
        config, consumer.descriptor, "tls", descriptor, identity, observed,
        consumer=True,
    )


def _publish_full(config: Config) -> dict[str, object]:
    producer = _open_root(
        config.producer_root,
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o700,
        label="private producer root",
    )
    consumer = _open_root(
        config.consumer_root,
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o700,
        label="user consumer root",
    )
    transaction = Transaction()
    staged_tls = ""
    reuse = None
    try:
        receipt, receipt_leaf, output_leaves, tls_leaves = _collect_producer(config, producer)
        _verify_consumer_sources(config, consumer, receipt)
        reuse = _consumer_tls_reuse(config, consumer, tls_leaves)
        if reuse is None:
            staged_tls = _stage_tls(config, consumer, tls_leaves)
        else:
            _assert_consumer_tls_reuse(config, consumer, reuse)
        transaction.detach_file(
            consumer.descriptor,
            "build-receipt.json",
            owner_uid=config.consumer_uid,
            owner_gid=config.consumer_gid,
            allowed_modes=frozenset({0o644}),
            label="consumer build receipt",
        )
        if reuse is None:
            transaction.swap_directory(
                consumer.descriptor,
                "tls",
                staged_tls,
                owner_uid=config.consumer_uid,
                owner_gid=config.consumer_gid,
                mode=0o700,
                label="consumer TLS directory",
            )
            staged_tls = ""
        for relative, mode in OUTPUT_MODES.items():
            parent, name, close_parent = _parent_and_name(
                consumer.descriptor,
                relative,
                uid=config.consumer_uid,
                gid=config.consumer_gid,
                create=True,
            )
            try:
                transaction.replace_file(
                    parent,
                    name,
                    output_leaves[relative].content,
                    mode=mode,
                    owner_uid=config.consumer_uid,
                    owner_gid=config.consumer_gid,
                    label=f"consumer output {relative}",
                )
            finally:
                if close_parent:
                    os.close(parent)
        transaction.replace_file(
            consumer.descriptor,
            "build-receipt.json",
            receipt_leaf.content,
            mode=0o644,
            owner_uid=config.consumer_uid,
            owner_gid=config.consumer_gid,
            label="consumer build receipt",
        )
        producer.revalidate()
        consumer.revalidate()
        if reuse is not None:
            _assert_consumer_tls_reuse(config, consumer, reuse)
        result = _observe_consumer(config, consumer, receipt_leaf, output_leaves, tls_leaves)
        if reuse is not None:
            _assert_consumer_tls_reuse(config, consumer, reuse)
        publication = receipt["runtime_publication"]
        assert isinstance(publication, Mapping)
        result["generation"] = publication["generation"]
        result["producer_receipt_sha256"] = receipt_leaf.sha256
        cleanup_warnings = transaction.commit()
        if cleanup_warnings:
            result["cleanup_warnings"] = list(cleanup_warnings)
        return result
    except BaseException as exc:
        if staged_tls:
            try:
                _remove_flat_directory(consumer.descriptor, staged_tls)
            except BaseException:
                pass
        try:
            transaction.rollback()
        except PublicationError as rollback_exc:
            if hasattr(exc, "add_note"):
                exc.add_note(str(rollback_exc))
        raise
    finally:
        if reuse is not None:
            os.close(reuse[0])
        consumer.close()
        producer.close()


def verify(config: Config) -> dict[str, object]:
    producer = _open_root(
        config.producer_root,
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o700,
        label="private producer root",
    )
    consumer = _open_root(
        config.consumer_root,
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o700,
        label="user consumer root",
    )
    try:
        receipt, receipt_leaf, output_leaves, tls_leaves = _collect_producer(config, producer)
        _verify_consumer_sources(config, consumer, receipt)
        result = _observe_consumer(config, consumer, receipt_leaf, output_leaves, tls_leaves)
        publication = receipt["runtime_publication"]
        assert isinstance(publication, Mapping)
        result["generation"] = publication["generation"]
        result["producer_receipt_sha256"] = receipt_leaf.sha256
        result["operation"] = "verify"
        result["ok"] = True
        producer.revalidate()
        consumer.revalidate()
        return result
    finally:
        consumer.close()
        producer.close()


def publish(config: Config) -> dict[str, object]:
    result = _publish_full(config)
    result["operation"] = "publish"
    result["ok"] = True
    return result


def _restore(config: Config, value: Mapping[str, object]) -> dict[str, object]:
    action = value.get("action")
    if action == "restored-runtime-generation":
        publication = _publish_full(config)
        result = dict(value)
        restored = result.get("restored")
        if not isinstance(restored, dict):
            raise PublicationError("runtime restore result is invalid")
        restored = dict(restored)
        restored["outputs"] = publication["outputs"]
        result["restored"] = restored
        result["receipt"] = publication["receipt"]
        if "cleanup_warnings" in publication:
            result["consumer_cleanup_warnings"] = publication["cleanup_warnings"]
        return result
    if action != "restored-tls-generation" or value.get("receipt") != "absent":
        raise PublicationError("unsupported preparer restore result")
    restored = value.get("restored")
    if not isinstance(restored, Mapping) or restored.get("path") != "tls":
        raise PublicationError("TLS restore result is invalid")
    manifest = restored.get("manifest")
    if not isinstance(manifest, Mapping):
        raise PublicationError("TLS restore manifest is invalid")

    producer = _open_root(
        config.producer_root,
        uid=config.preparer_uid,
        gid=config.preparer_gid,
        mode=0o700,
        label="private producer root",
    )
    consumer = _open_root(
        config.consumer_root,
        uid=config.consumer_uid,
        gid=config.consumer_gid,
        mode=0o700,
        label="user consumer root",
    )
    transaction = Transaction()
    staged_tls = ""
    try:
        producer_tls = _open_named_directory(
            producer.descriptor,
            "tls",
            uid=config.preparer_uid,
            gid=config.preparer_gid,
            mode=0o700,
            label="producer TLS directory",
        )
        tls_leaves: dict[str, Leaf] = {}
        try:
            names = set(manifest)
            if not TLS_REQUIRED.issubset(names) or not names.issubset(TLS_REQUIRED | TLS_OPTIONAL):
                raise PublicationError("restored TLS manifest has an unsafe leaf set")
            for name, claim in manifest.items():
                if not isinstance(name, str) or not isinstance(claim, Mapping):
                    raise PublicationError("restored TLS manifest is invalid")
                mode = claim.get("mode")
                expected_mode = TLS_REQUIRED_MODES.get(name, TLS_OPTIONAL_MODES.get(name))
                if not isinstance(mode, int) or expected_mode is None or mode != expected_mode:
                    raise PublicationError("restored TLS manifest mode is invalid")
                identity, digest = _identity_claim(claim, mode=mode, label=f"restored TLS {name}")
                leaf = _read_leaf(
                    producer_tls,
                    name,
                    uid=config.preparer_uid,
                    gid=config.preparer_gid,
                    mode=mode,
                    label=f"restored producer TLS {name}",
                )
                if leaf.identity.payload() != identity or leaf.sha256 != digest:
                    raise PublicationError(f"restored producer TLS does not match result: {name}")
                tls_leaves[name] = leaf
        finally:
            os.close(producer_tls)
        staged_tls = _stage_tls(config, consumer, tls_leaves)
        transaction.detach_file(
            consumer.descriptor,
            "build-receipt.json",
            owner_uid=config.consumer_uid,
            owner_gid=config.consumer_gid,
            allowed_modes=frozenset({0o644}),
            label="consumer build receipt",
        )
        transaction.swap_directory(
            consumer.descriptor,
            "tls",
            staged_tls,
            owner_uid=config.consumer_uid,
            owner_gid=config.consumer_gid,
            mode=0o700,
            label="consumer TLS directory",
        )
        staged_tls = ""
        producer.revalidate()
        consumer.revalidate()
        result = dict(value)
        cleanup_warnings = transaction.commit()
        if cleanup_warnings:
            result["consumer_cleanup_warnings"] = list(cleanup_warnings)
        return result
    except BaseException as exc:
        if staged_tls:
            try:
                _remove_flat_directory(consumer.descriptor, staged_tls)
            except BaseException:
                pass
        try:
            transaction.rollback()
        except PublicationError as rollback_exc:
            if hasattr(exc, "add_note"):
                exc.add_note(str(rollback_exc))
        raise
    finally:
        consumer.close()
        producer.close()


def restore(config: Config, value: Mapping[str, object]) -> dict[str, object]:
    result = _restore(config, value)
    return {
        "schema": SCHEMA,
        "operation": "restore",
        "ok": True,
        "result": result,
    }


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("operation", choices=("seed", "publish", "verify", "restore"))
    parser.add_argument("--producer-root", required=True)
    parser.add_argument("--consumer-root", required=True)
    parser.add_argument("--preparer-uid", type=int, required=True)
    parser.add_argument("--preparer-gid", type=int, required=True)
    parser.add_argument("--consumer-uid", type=int, required=True)
    parser.add_argument("--consumer-gid", type=int, required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    if os.getresuid() != (0, 0, 0) or os.getresgid() != (0, 0, 0):
        raise PublicationError("publication helper requires the full root principal")
    arguments = _parser().parse_args(sys.argv[1:] if argv is None else argv)
    config = Config(
        Path(arguments.producer_root),
        Path(arguments.consumer_root),
        arguments.preparer_uid,
        arguments.preparer_gid,
        arguments.consumer_uid,
        arguments.consumer_gid,
    )
    if arguments.operation == "seed":
        result = seed(config)
    elif arguments.operation == "publish":
        result = publish(config)
    elif arguments.operation == "verify":
        result = verify(config)
    else:
        content = sys.stdin.buffer.read(RECEIPT_MAX_BYTES + 1)
        if not content or len(content) > RECEIPT_MAX_BYTES:
            raise PublicationError("restore result input is invalid")
        value = _strict_json(content, label="preparer restore result")
        result = restore(config, value)
    sys.stdout.buffer.write(_canonical_json(result))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PublicationError as exc:
        sys.stderr.write(f"TermDeck preparer publication refused: {exc}\n")
        raise SystemExit(2)
