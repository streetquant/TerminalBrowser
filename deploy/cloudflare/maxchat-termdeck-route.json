{
  "comment": "Insert this rule before the existing maxchat.semiotech.org catch-all. Preserve all existing tunnel rules after it.",
  "hostname": "maxchat.semiotech.org",
  "path": "^/t1000(?:/.*)?$",
  "service": "https://127.0.0.1:7443",
  "originRequest": {
    "originServerName": "termdeck.local",
    "caPool": "/var/lib/codexpro-exec/termdeck-runtime/termdeck-lan/tls/ca.crt",
    "httpHostHeader": "maxchat.semiotech.org",
    "connectTimeout": "5s",
    "tlsTimeout": "5s",
    "tcpKeepAlive": "30s",
    "keepAliveConnections": 100,
    "keepAliveTimeout": "90s"
  }
}
