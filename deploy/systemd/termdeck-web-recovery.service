[Unit]
Description=TermDeck web activation recovery watchdog
After=warp.mount default.target
ConditionPathIsMountPoint=/warp
ConditionPathIsDirectory=/warp/projects/softwares/termdeck
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck/t1000-managed
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck/bin
# No pending activation is a successful inactive condition; a present LATEST
# is watched until it reaches a terminal state.
ConditionPathExists=/warp/projects/softwares/termdeck/.termdeck/state/recovery/activation-v2/LATEST
RequiresMountsFor=/warp/projects/softwares/termdeck /warp/projects/softwares/termdeck/.termdeck /warp/projects/softwares/termdeck/.termdeck/state
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/warp/projects/softwares/termdeck/.termdeck/state
Environment=USER=max
Environment=LOGNAME=max
Environment=PATH=/warp/projects/softwares/termdeck/.termdeck/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-recovery
ExecStop=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-recovery-stop
Restart=on-failure
RestartMode=direct
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/warp/projects/softwares/termdeck/.termdeck/state/recovery/activation-v2 /warp/projects/softwares/termdeck/.termdeck /home/arch/.config/systemd/user /warp/projects/softwares/termdeck/.termdeck/t1000-managed /warp/projects/softwares/termdeck/.termdeck/bin
TimeoutStartSec=30s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
