[Unit]
Description=TermDeck root runtime attestation signer
Documentation=https://github.com/Rebel0789/t1000
After=local-fs.target systemd-tmpfiles-setup.service
RequiresMountsFor=/var/lib/termdeck-preparer/runtime
ConditionPathIsDirectory=/etc/termdeck/control
ConditionPathIsDirectory=/etc/termdeck/control/records
ConditionPathIsDirectory=/var/lib/termdeck-preparer/runtime
ConditionPathExists=/etc/termdeck/control/runtime-attestd.key
ConditionPathExists=/etc/termdeck/runtime-attestd.pub
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/libexec/termdeck-runtime-attestd daemon
Restart=on-failure
RestartMode=direct
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillMode=control-group

# The signer may mutate only its root-owned socket/record namespace.  Its
# private key remains read-only inside that exception.  The private preparer
# runtime is bound read-only so a receipt produced after daemon startup becomes
# visible without exposing the max-owned consumer tree or any user state.
ProtectSystem=strict
ReadWritePaths=/etc/termdeck/control
ReadOnlyPaths=/etc/termdeck/control/runtime-attestd.key /etc/termdeck/runtime-attestd.pub
BindReadOnlyPaths=/var/lib/termdeck-preparer/runtime

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateMounts=yes
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=32
LimitNOFILE=256
MemoryMax=256M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
