[Unit]
Description=Temporary Cloudflare Quick Tunnel preview for TermDeck
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/do-more-with-tunnels/trycloudflare/
Wants=network-online.target termdeck-web-lan.service
After=warp.mount network-online.target termdeck-web-lan.service
ConditionPathIsMountPoint=/warp
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck
RequiresMountsFor=/warp/projects/softwares/termdeck /warp/projects/softwares/termdeck/.termdeck /warp/projects/softwares/termdeck/.termdeck/state
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/warp/projects/softwares/termdeck/.termdeck/state
Environment=USER=max
Environment=LOGNAME=max
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-cloudflare-preview
ExecStop=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-cloudflare-preview-stop
Restart=on-failure
RestartMode=direct
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
ReadWritePaths=/warp/projects/softwares/termdeck/.termdeck
LimitNOFILE=65536
TasksMax=1024
MemoryHigh=512M
MemoryMax=1G
CPUWeight=100
IOWeight=100
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
