[Unit]
Description=Temporary Cloudflare Quick Tunnel preview for TermDeck
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/do-more-with-tunnels/trycloudflare/
Wants=network-online.target termdeck-web-lan.service
After=network-online.target termdeck-web-lan.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/home/arch
Environment=USER=max
Environment=LOGNAME=max
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/var/lib/codexpro-exec/termdeck-runtime/termdeck-lan/bin/termdeck-cloudflare-preview
Restart=always
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/codexpro-exec/termdeck-runtime/termdeck-lan
LimitNOFILE=65536
TasksMax=1024
MemoryHigh=512M
MemoryMax=1G
CPUWeight=100
IOWeight=100
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
