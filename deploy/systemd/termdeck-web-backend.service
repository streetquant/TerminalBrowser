[Unit]
Description=TermDeck authenticated web backend
Wants=network-online.target
After=warp.mount network-online.target
ConditionPathIsMountPoint=/warp
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck/state
RequiresMountsFor=/warp/projects/softwares/termdeck /warp/projects/softwares/termdeck/.termdeck /warp/projects/softwares/termdeck/.termdeck/state
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=%h
Environment=USER=max
Environment=LOGNAME=max
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=TERMDECK_STATE_ROOT=/warp/projects/softwares/termdeck/.termdeck/state
Environment=PATH=/warp/projects/softwares/termdeck/.termdeck/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-backend
ExecStop=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-backend-stop
Restart=on-failure
RestartMode=direct
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
TasksMax=4096
MemoryHigh=2G
MemoryMax=4G
CPUWeight=200
IOWeight=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
