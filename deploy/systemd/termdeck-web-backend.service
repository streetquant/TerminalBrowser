[Unit]
Description=TermDeck authenticated web backend
Wants=network-online.target
After=warp.mount network-online.target
ConditionPathIsMountPoint=/warp
ConditionPathIsDirectory=/warp/runtime/termdeck/termdeck-lan
ConditionPathIsDirectory=/warp/state/termdeck
RequiresMountsFor=/warp/projects/software/termdeck /warp/runtime/termdeck /warp/state/termdeck
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/warp/state/termdeck
Environment=USER=max
Environment=LOGNAME=max
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=TERMDECK_STATE_ROOT=/warp/state/termdeck
Environment=PATH=/warp/runtime/termdeck/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/warp/runtime/termdeck/t1000-managed/termdeck-web-backend
ExecStop=/warp/runtime/termdeck/t1000-managed/termdeck-web-backend-stop
Restart=on-failure
RestartMode=direct
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillMode=control-group
LimitNOFILE=65536
TasksMax=4096
MemoryHigh=2G
MemoryMax=4G
CPUWeight=200
IOWeight=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
