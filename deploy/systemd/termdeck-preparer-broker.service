[Unit]
Description=TermDeck one-request privileged preparer broker
Documentation=https://github.com/Rebel0789/t1000
After=local-fs.target termdeck-runtime-attestd.service
Wants=termdeck-runtime-attestd.service
Requires=termdeck-preparer-broker.socket
RequiresMountsFor=/var/lib/termdeck-preparer/runtime /warp/projects/softwares/termdeck/.termdeck
ConditionPathIsDirectory=/var/lib/termdeck-preparer/runtime
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck
RefuseManualStart=yes

[Service]
Type=exec
User=root
Group=root
UMask=0077
Sockets=termdeck-preparer-broker.socket
ExecStart=/usr/libexec/termdeck-preparer-broker
Restart=no
TimeoutStartSec=200s
TimeoutStopSec=10s
RuntimeMaxSec=200s
KillMode=control-group

# systemd owns the max-only activation socket.  The root broker validates its
# single named LISTEN_FD and SO_PEERCRED, seeds the private producer through a
# fixed root-owned helper, and then drops the preparer child to its dedicated
# identity.  Only the fixed root helper may publish receipt-bound outputs into
# the max-owned consumer tree; the unprivileged preparer never writes there.
RuntimeDirectory=termdeck-preparer-broker
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/termdeck-preparer /warp/projects/softwares/termdeck/.termdeck
TemporaryFileSystem=/warp:ro
BindPaths=/warp/projects/softwares/termdeck/.termdeck

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
IPAddressDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=8
LimitNOFILE=64
MemoryMax=256M

StandardOutput=journal
StandardError=journal
