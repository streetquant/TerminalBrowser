[Unit]
Description=TermDeck LAN HTTPS, WebSocket and prefixed Cloudflare proxy
Wants=network-online.target termdeck-web-backend.service
After=warp.mount network-online.target termdeck-web-backend.service
ConditionPathIsMountPoint=/warp
ConditionPathIsDirectory=/warp/projects/softwares/termdeck/.termdeck
RequiresMountsFor=/warp/projects/softwares/termdeck /warp/projects/softwares/termdeck/.termdeck /warp/projects/softwares/termdeck/.termdeck/state
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/warp/projects/softwares/termdeck/.termdeck/state
Environment=USER=max
Environment=LOGNAME=max
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PATH=/warp/projects/softwares/termdeck/.termdeck/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-lan
ExecStop=/warp/projects/softwares/termdeck/.termdeck/t1000-managed/termdeck-web-lan-stop
Restart=on-failure
RestartMode=direct
RestartSec=2s
TimeoutStartSec=45s
TimeoutStopSec=30s
KillSignal=SIGQUIT
KillMode=control-group
LimitNOFILE=65536
TasksMax=1024
MemoryHigh=1G
MemoryMax=2G
CPUWeight=200
IOWeight=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
