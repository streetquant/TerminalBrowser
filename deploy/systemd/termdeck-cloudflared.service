[Unit]
Description=Cloudflare Tunnel for TermDeck
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
Wants=network-online.target termdeck-web-lan.service
After=network-online.target termdeck-web-lan.service
RequiresMountsFor=/warp
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=HOME=/home/arch
Environment=USER=max
Environment=LOGNAME=max
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/cloudflared --config /warp/runtime/termdeck/cloudflared/termdeck.yml --no-autoupdate tunnel run
Restart=always
RestartSec=3s
TimeoutStartSec=45s
TimeoutStopSec=45s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536
TasksMax=1024
MemoryHigh=512M
MemoryMax=1G
CPUWeight=150
IOWeight=150
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
