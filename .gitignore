# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
# Disposable pytest basetemp state; never package credentials or test databases.
.t/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build/package artefacts
build/
dist/
*.egg-info/
.eggs/
web/target/

# Local runtime state
.termdeck/
*.sqlite
*.sqlite3
# Preserve local database recovery copies without publishing their contents.
/sessions.sqlite3.pre-*
*.db

# Editor/OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# Local/generated files
user-prompt.md
# Portable BR ledger is Git-visible; .beads/.gitignore excludes local state.
codex-session-id.txt
.ai-bridge/
.codex-workspace-id.json

# bv (beads viewer) local config and caches
.bv/
